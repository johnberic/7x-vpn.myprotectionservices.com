from flask import Flask, jsonify, request
import mysql.connector
import subprocess
import re
import time

app = Flask(__name__)

# Cache para sa mga aktibong user { "username": timestamp }
active_users_cache = {}

def load_db_config():
    config = {}
    try:
        with open('/etc/openvpn/login/config.sh', 'r') as f:
            for line in f:
                match = re.match(r'^\s*(USER|PASS|DB|HOST)\s*=\s*["\']?(.*?)["\']?\s*$', line)
                if match:
                    config[match.group(1)] = match.group(2)
    except Exception as e:
        print(f"Error loading config.sh: {e}")
    return config

def verify_user_status(user_name):
    db_cfg = load_db_config()
    if not db_cfg:
        return {"valid": False, "reason": "Database Config Error"}
    try:
        conn = mysql.connector.connect(
            host=db_cfg.get('HOST', 'localhost'),
            user=db_cfg.get('USER'),
            password=db_cfg.get('PASS'),
            database=db_cfg.get('DB')
        )
        cursor = conn.cursor(dictionary=True)
        query = "SELECT user_name, duration, is_freeze FROM users WHERE user_name = %s"
        cursor.execute(query, (user_name,))
        user = cursor.fetchone()
        cursor.close()
        conn.close()
        
        if user:
            if str(user['is_freeze']) == "1":
                return {"valid": False, "reason": "frozen"}
            if int(user['duration']) <= 0:
                return {"valid": False, "reason": "expired"}
            return {"valid": True, "reason": "active"}
        return {"valid": False, "reason": "not_found"}
    except Exception:
        return {"valid": False, "reason": "db_error"}

def clean_expired_users():
    """Tatanggalin ang mga user na hindi nagparamdam sa loob ng 30 segundo"""
    current_time = time.time()
    expired_users = [uid for uid, ltime in active_users_cache.items() if current_time - ltime > 30]
    for uid in expired_users:
        del active_users_cache[uid]

# ----------------- MGA API ENDPOINTS ----------------- #

@app.route('/api/online/<user_id>', methods=['GET'])
def check_online(user_id):
    account = verify_user_status(user_id)
    if account["valid"]:
        active_users_cache[user_id] = time.time()
        
    clean_expired_users()
    return jsonify({
        "status": "success" if account["valid"] else "unauthorized",
        "user": user_id,
        "is_online": account["valid"],
        "total_online_count": len(active_users_cache),
        "account_status": account.get("reason", "active")
    }), 200 if account["valid"] else 401

@app.route('/api/count', methods=['GET'])
def live_count_for_app():
    user_id = request.args.get('user')
    if user_id:
        account = verify_user_status(user_id)
        if account["valid"]:
            active_users_cache[user_id] = time.time()

    clean_expired_users()
    return str(len(active_users_cache)), 200

