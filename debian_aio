#====================================================
#	Installing Hysteria1 and Hysteria2
#	Finalized: Tknetwork Developer
#====================================================
install_dual_hysteria() {
  clear
  echo -e "\e[1;35m = =================================================\e[0m"
  echo -e "\e[1;36m      HYSTERIA V1 & V2 DUAL PROTOCOL INSTALLER    \e[0m"
  echo -e "\e[1;35m = =================================================\e[0m"

  # = ===================================================================
  # 1. CLEAN OLD FILES AND FREE DISK SPACE
  # = ===================================================================
  show_status "Cleaning temporary files and old logs"

  apt-get clean >/dev/null 2>&1
  rm -rf /var/log/*.gz /var/log/*.1 >/dev/null 2>&1

  if command -v journalctl &>/dev/null; then
  # if statement
    journalctl --vacuum-time = 1d >/dev/null 2>&1
  fi

  mkdir -p /etc/hysteria
  chmod 755 /usr/local/bin

  # = ===================================================================
  # 2. STOP OLD SERVICES AND REMOVE CONFLICTS
  # = ===================================================================
  show_status "Stopping old Hysteria services and clearing conflicts"

  systemctl disable --now hysteria hysteria-server hysteria-luma hysteria-v2 >/dev/null 2>&1
  systemctl reset-failed >/dev/null 2>&1

  rm -f /etc/systemd/system/hysteria.service
  rm -f /etc/systemd/system/hysteria-server.service

  pkill -9 -f hysteria >/dev/null 2>&1

  # = ===================================================================
  # 3. INSTALL HYSTERIA 2 CORE
  # = ===================================================================
  show_status "Installing Hysteria 2 Core"

  if ! bash <(curl -fsSL https://get.hy2.sh/) --skip-service >/dev/null 2>&1; then
  # if statement
    show_status "Retrying installation using fallback mode"

    bash <(curl -fsSL https://get.hy2.sh/) >/dev/null 2>&1 || {
    echo -e "\e[1;31m[ERROR]\e[0m Failed to install Hysteria 2"
    return 1
  }
fi

# = ===================================================================
# 4. INSTALL HYSTERIA 1 CORE
# = ===================================================================
show_status "Installing Hysteria 1 Core"

wget -q -O /usr/local/bin/hysteria-v1 \
https://github.com/apernet/hysteria/releases/download/v1.3.5/hysteria-linux-amd64

chmod +x /usr/local/bin/hysteria-v1

# = ===================================================================
# 5. CREATE AUTHENTICATION SCRIPT
# = ===================================================================
show_status "Creating unified authentication bridge"

cat <<"EOM" >/etc/hysteria/.auth.sh
#!/bin/bash
PATH = /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# MAG-LOG NG SIMULA NG AUTH
echo " = == AUTH ATTEMPT: $(date) ===" >> /var/log/hysteria-auth.log

# 1. LOAD CONFIG NG DATABASE
if [ -f /etc/openvpn/login/config.sh ]; then
# if statement
  source /etc/openvpn/login/config.sh
  echo "Database Config Loaded Successfully" >> /var/log/hysteria-auth.log
else
  echo "ERROR: /etc/openvpn/login/config.sh NOT FOUND OR NOT READABLE" >> /var/log/hysteria-auth.log
  echo "Authentication failed."
  exit 1
fi

# 2. AUTOMATIC ARGUMENT DETECTION
AUTH = ""
for arg in "$@"; do
# for statement
  if [[ "$arg" == *":"* && "$arg" != *"."* ]]; then
  # if statement
    AUTH = "$arg"
    break
  fi
done

if [ -z "$AUTH" ]; then
# if statement
  AUTH = $2
fi

# 3. EXTRACT USERNAME AND PASSWORD
USERNAME = $(echo "$AUTH" | cut -d ":" -f 1 | tr -d "\r\n[:space:]")
PASSWORD = $(echo "$AUTH" | cut -d ":" -f 2 | tr -d "\r\n[:space:]")

echo "Total Arguments Received: $#" >> /var/log/hysteria-auth.log
echo "All Arguments: $@" >> /var/log/hysteria-auth.log
echo "Detected Auth String: [$AUTH]" >> /var/log/hysteria-auth.log
echo "Attempting login for User: [$USERNAME]" >> /var/log/hysteria-auth.log

# 4. RUN MYSQL QUERY
MYSQL_BIN = $(which mysql 2>/dev/null || echo "/usr/bin/mysql")
Query = "SELECT user_name FROM users WHERE user_name="${USERNAME}" AND auth_vpn=MD5("${PASSWORD}") AND is_freeze="0" AND duration > 0"

username = $($MYSQL_BIN -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -sN -e "$Query" 2>>/var/log/hysteria-auth.log)

